{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "jxhaote-site",
  "main": "workers/api.ts",
  "compatibility_date": "2026-07-22",

  // 保留 workers.dev 访问地址，自定义域生效后两者并存
  "workers_dev": true,

  // 自定义域名：需先将 jxhaote.cn 添加到 Cloudflare 并修改 NS
  "routes": [
    { "pattern": "www.jxhaote.cn", "custom_domain": true, "zone_name": "jxhaote.cn" },
    { "pattern": "jxhaote.cn", "custom_domain": true, "zone_name": "jxhaote.cn" }
  ],

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // 询盘邮件配置（RESEND_API_KEY 用 secret，不要写进仓库）
  // 配置命令：npx wrangler secret put RESEND_API_KEY
  // 未验证 jxhaote.cn 时：优先 ht13 失败 → 自动改发 CONTACT_FALLBACK_EMAIL
  "vars": {
    "CONTACT_TO_EMAIL": "ht13@jxhaote.cn",
    "CONTACT_FALLBACK_EMAIL": "huabo19990706@gmail.com",
    "CONTACT_FROM_EMAIL": "Jiaxing Haote <onboarding@resend.dev>"
  }
}
