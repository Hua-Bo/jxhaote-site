# 嘉兴浩天化工独立站 — 环境变量模板
# 复制为 .env.development（本地）或 .env.production（生产）

# 站点根路径（自定义域 / Cloudflare 用 /）
VITE_BASE=/

# 站点名称（浏览器标题默认值）
VITE_APP_TITLE=Jiaxing Haote Chemical

# 正式域名
VITE_SITE_URL=https://www.jxhaote.cn

# WhatsApp 联系号码（国际格式，不含 +）
VITE_WHATSAPP=8618767352698

# 联系邮箱（页脚展示 / 询盘收件地址，实际发信由 Worker + Resend 完成）
VITE_CONTACT_EMAIL=info@jxhaote.cn

# ---------- Cloudflare Worker 本地联调（写在 .dev.vars，不要提交）----------
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=info@jxhaote.cn
# CONTACT_FROM_EMAIL=Jiaxing Haote <onboarding@resend.dev>
